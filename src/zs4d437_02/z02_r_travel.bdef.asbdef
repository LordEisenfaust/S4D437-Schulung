managed implementation in class zbp_02_r_travel unique;
strict ( 2 );
with draft; //Draft definieren

define behavior for Z02_R_TRAVEL alias Travel //alias <alias_name>

persistent table z02_travel ##unmapped_field //->kann vorkommen und wird mit
with additional save //für eventhandling
draft table z02_traveld  //Draft Tabelle
lock master
total etag ChangedAt     //Active etag
authorization master ( instance )
etag master LocChangedAt       //Draft etag


early numbering
{ create ( authorization : global );
  update ( features : instance );
  delete;
  action ( features : instance ) cancel_travel;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  { validation validateDescription;
    validation validateCustomerId;
    validation validateBeginDate;
    validation validateEndDate;
    validation validateBeginEnd;
    validation item~validateFlightDate; } //Validation eines Items

  //Feldsteuerungen grundsätzlich (können in der instance-Featrure Methode übersteuert werden)
  field ( readonly ) Status, ChangedAt, ChangedBy, Duration;
  field ( readonly ) AgencyID, TravelId; //für early numbering nur readonly
  field ( mandatory ) Description, CustomerId, BeginDate, EndDate; //Mussfeld, aber kein Key Feld, somit nicht geprüft
  field ( features : instance ) BeginDate, EndDate;

//CDS Abstracte Entitäten --> Typen definieren (zusätzlich Entität mitgeben)
//Event struktur definieren
event travelCreated parameter z02_A_event;

  // Derterminationen können einzeln aufgerufen werden für Werte zu Berechnen
  //                  und man kann die Felder + die Zeit mitgeben
  determination setStatusNew on modify { create; }
  determination determineDuration on save { create; field BeginDate, EndDate; }

  //Determine Actions - Zusammenfassung von Validierungen und Determination, welche ausführbar sind
  determine action checkCustomer { validation validateCustomerId; }
  determine action recalculateDuration
  { determination determineDuration;
    validation validateBeginDate;
    validation validateEndDate;
    validation validateBeginEnd; }

  //Aufruf der definierten Actions - einmal normale Actions und Determine Actions
  side effects
  { action cancel_travel affects field status;
    determine action checkCustomer executed on field CustomerId affects messages;
    determine action recalculateDuration executed on field BeginDate, field EndDate affects field Duration, messages; }
  //Validation
  validation validateDescription on save { create; update; field Description; }
  validation validateCustomerId on save { create; update; field CustomerId; }
  validation validateBeginDate on save { create; update; field BeginDate; }
  validation validateEndDate on save { create; update; field EndDate; }
  validation validateBeginEnd on save { create; update; field BeginDate, EndDate; }


  association _Item { create; with draft; } //

  mapping for z02_travel corresponding
    {
      AgencyId     = agency_id;
      TravelId     = travel_id;
      //Description = description; //nicht notwendig, corresponding
      CustomerId   = customer_id;
      BeginDate    = begin_date;
      EndDate      = end_date;
      //Status      = status;  //nicht notwendig, corresponding
      ChangedAt    = changed_at;
      ChangedBy    = changed_by;
      LocChangedAt = localchanged_at;
    }
}

define behavior for Z02_R_TRAVELITEM alias Item
with unmanaged save
//persistent table z02_tritem  /kommt weg bei unmanaged
draft table z02_tritemd  //Draft Tabelle
lock dependent by _Travel
authorization dependent by _Travel
etag master LocChangedAt
{
  //create; ist nicht erlaubt im Item
  update;
  delete;

  field ( readonly, numbering : managed ) ItemUuid;
  field ( readonly ) AgencyId, TravelId;

  validation validateFlightDate on save { create; field FlightDate; }

  determination determineTravelDates on save { field FlightDate; }


  association _Travel { with draft; } //CDS Alias

  //  mapping for z02_tritem corresponding //alt
  mapping for /lrn/437_s_tritem control /lrn/437_s_tritemx corresponding //neu
    {
      ItemUuid           = item_uuid;
      AgencyId           = agency_id;
      TravelId           = travel_id;
      CarrierId          = carrier_id;
      ConnectionId       = connection_id;
      FlightDate         = flight_date;
      BookingId          = booking_id;
      PassengerFirstName = passenger_first_name;
      PassengerLastName  = passenger_last_name;
      ChangedAt          = changed_at;
      ChangedBy          = changed_by;
      LocChangedAt       = loc_changed_at;
    }
}