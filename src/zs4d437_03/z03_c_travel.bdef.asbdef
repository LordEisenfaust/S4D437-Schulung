projection;
strict ( 2 );
use draft;
define behavior for Z03_C_TRAVEL alias Travel
use etag
{
  use create;
  use update;
  use delete;
  use action Edit;
  use action Resume;
  use action Activate;
  use action Prepare;
  use action Discard;
  use action checkCustomer;

use action cancel_travel;

use association _TravelItem { create; with draft; }
}

define behavior for Z03_C_TravelItem
use etag
{
	use update;
	use delete;
	use association _Travel { with draft; }
}