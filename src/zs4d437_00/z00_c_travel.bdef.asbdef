projection;
strict ( 2 );
use draft;
use side effects;
define behavior for Z00_C_Travel alias Travel
use etag
{
  use create;
  use update;
  use delete;
  use action Edit;
  use action Resume;
  use action Activate;
  use action Prepare;
  use action Discard;
  use action recalculateDuration;

  use action cancelTravel;

  use association _Item { create; with draft; }

}

define behavior for z00_c_travelitem alias Item
use etag
{
use update;
use delete;
use association _Travel { with draft; }
}