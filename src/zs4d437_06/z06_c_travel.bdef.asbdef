projection;
strict ( 2 );
use draft;
use side effects;
define behavior for Z06_C_TRAVEL alias Travel
use etag
{

  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;

  use create;
  use update;
  use delete;
  use action cancel_travel;
  use action CheckCustomer;
  use action adjustDuration;

  side effects
  {
  determine action CheckCustomer
  executed on field CustomerId
  affects messages ;
  }

  use association _Item { create; with draft;}
}

define behavior for z06_C_TravelItem
use etag
{
  use update;
  use delete;

  use association _Travel { with draft; }
}