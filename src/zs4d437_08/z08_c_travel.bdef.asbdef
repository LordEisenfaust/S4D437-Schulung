projection;
strict ( 2 );

use draft;
use side effects;
define behavior for Z08_C_TRAVEL alias Travel
{
  use create;
  use update;
  use delete;

   use action Edit;
   use action Activate;
   use action Discard;
   use action Prepare;
   use action Resume;

 use action canceltravel;

 use association _Item { create; with draft; }
}
define behavior for Z08_C_TRAVELITEM alias Item

use etag
{

 use update;
 use delete;
 use association _Travel { with draft; }
 }