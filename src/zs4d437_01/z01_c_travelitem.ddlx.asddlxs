@Metadata.layer: #CORE

@UI: {
   headerInfo: {
     typeName: 'Flight Travel Item',
     typeNamePlural: 'Flight Travel Items'
               }
     }

annotate view Z01_C_TRAVELITEM with
{

  @UI.facet: [ { id:            'Booking',
                purpose:       #STANDARD,
                type:          #IDENTIFICATION_REFERENCE,
                label:         'Travel Item',
                position:      10 } ]

  @UI.hidden: true
  ItemUuid;

  @UI: {
        identification: [ { position: 10, importance: #LOW } ]
      }
  AgencyId;
  @UI: {
          identification: [ { position: 20, importance: #LOW } ]
        }
  TravelId;
  @UI: {
          identification: [ { position: 30, importance: #HIGH } ]
        }

  @Consumption.valueHelpDefinition:
             [ { entity: { name:    '/DMO/I_Carrier_StdVH',
                           element: 'AirlineID'
                         }
               }
             ]
  CarrierId;
  @UI: {
          lineItem:       [ { position: 40, importance: #HIGH } ],
          identification: [ { position: 40, importance: #HIGH } ]
        }
  @Consumption.valueHelpDefinition:
      [
               { entity: { name:    '/DMO/I_Connection_StdVH',
                             element: 'ConnectionID'
                           },
                   additionalBinding:
                        [ { localElement: 'CarrierId',
                                 element: 'AirlineID',
                                   usage: #FILTER_AND_RESULT
                          }
                        ],
                   label: 'Value Help by Connection',
                   qualifier: 'One'
                 },
                 { entity: { name:    '/DMO/I_Flight_StdVH',
                             element: 'ConnectionID'
                           },
                   additionalBinding:
                        [ { localElement: 'CarrierId',
                            element:      'AirlineID',
                            usage:        #FILTER_AND_RESULT
                          },
                          { localElement: 'FlightDate',
                            element:      'FlightDate',
                            usage:         #RESULT
                         }
                       ],
                   label: 'Value Help by Flight',
                   qualifier: 'Two'
                 }
        ]
  ConnectionId;
  @UI: {
          lineItem:       [ { position: 50, importance: #HIGH } ],
          identification: [ { position: 50, importance: #HIGH } ]
        }
  @Consumption.valueHelpDefinition:
           [ { entity: { name:    '/DMO/I_Flight_StdVH',
                         element: 'FlightDate'
                       },
               additionalBinding:
                    [ { localElement: 'CarrierId',
                        element:      'AirlineID',
                        usage:         #FILTER_AND_RESULT
                      },
                      { localElement: 'ConnectionId',
                        element:      'ConnectionID',
                        usage:        #RESULT
                      }
                    ]
             }
           ]
  FlightDate;
  @UI: {
          lineItem:       [ { position: 60, importance: #HIGH } ],
          identification: [ { position: 60, importance: #HIGH } ]
        }
  BookingId;
  @UI: {
          identification: [ { position: 70, importance: #MEDIUM } ]
       }
  PassengerFirstName;
  @UI: {
          identification: [ { position: 80, importance: #MEDIUM } ]
       }
  PassengerLastName;

  @UI.hidden: true
  ChangedAt;
  @UI.hidden: true
  ChangedBy;
  @UI.hidden: true
  LocChangedAt;

}