projection;
strict ( 2 );
use draft;
use side effects;
define behavior for Z10_C_TRAVEL //alias <alias_name>
use etag

{
  use create;
  use update;
  use delete;
  use action cancel_travel;
  use action Activate;
  use action Discard;
  use action Edit;
  use action Prepare;
  use action Resume;
  use action checkCustomer;

  use association _Item { create; with draft; }

}

define behavior for Z10_C_TRAVELITEM
use etag
 {
 use update;
 use delete;
 use association _Travel { with draft; }
	
}